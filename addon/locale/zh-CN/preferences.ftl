pref-help = { $name } Build { $version } { $time }

pref-feature-groups = 功能模块
pref-context-menu-features = 水平标签右键菜单动作
pref-enable-vertical-tabs =
    .label = 启用垂直标签栏
pref-enable-horizontal-tab-enhance =
    .label = 启用水平标签右键增强
pref-enable-copy-reference =
    .label = 启用右键复制引用
pref-enable-go-to-attachment =
    .label = 启用右键跳转到附件
pref-enable-reload-tab =
    .label = 启用右键重新加载标签页

pref-tab-display = 侧边栏标签页自定义
pref-vertical-tab-title-mode = 标签页主标题
pref-vertical-tab-title-mode-title = 标题
pref-vertical-tab-title-mode-short-title = 短标题
pref-vertical-tab-subtitle-mode = 标签页副标题
pref-vertical-tab-subtitle-mode-source = 来源（期刊/会议/书籍等）
pref-vertical-tab-subtitle-mode-creator-year = 作者与年份
pref-vertical-tab-subtitle-mode-type-and-item = 类型与条目编号
pref-vertical-tab-subtitle-mode-none = 不显示
pref-vertical-tab-row-height = 标签页高度（像素，最低 32）
pref-vertical-tab-font-size = 标签文字大小（像素，最低 10）
pref-vertical-tab-custom-css = 标签页与分组标题自定义 CSS
pref-vertical-tab-custom-css-hint = 仅作用于垂直标签栏内部，留空即使用默认样式。常用选择器：.tab-enhance-vertical-group-header、.tab-enhance-vertical-group-title、.tab-enhance-vertical-tab-row、.tab-enhance-vertical-tab-row.is-selected、.tab-enhance-vertical-tab-title、.tab-enhance-vertical-tab-meta。深色主题的默认样式优先级更高（.tab-enhance-vertical-tabs-sidebar.is-dark-theme …），需加上该前缀或使用 !important。嵌套规则以及除 @media 和 @supports 外的 @ 规则会被忽略。

pref-group-colors = 分组基础颜色
pref-group-color-1 = 颜色 1
pref-group-color-2 = 颜色 2
pref-group-color-3 = 颜色 3
pref-group-color-4 = 颜色 4
pref-group-color-5 = 颜色 5
pref-group-color-6 = 颜色 6
pref-group-color-7 = 颜色 7
pref-group-color-8 = 颜色 8

pref-data-reset = 数据重置
pref-reset-plugin-data = 一键清除插件持久化数据并恢复初始化状态
